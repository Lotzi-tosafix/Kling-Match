# ─────────────────────────────────────────────
# Kling-Match — .gitignore
# ─────────────────────────────────────────────

# ── Python cache ──────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python

# ── Virtual environments ──────────────────────
venv/
.venv/
env/
.env/

# ── PyInstaller build output ──────────────────
dist/
build/Kling-Match/
*.spec.bak

# ── Eggs / packaging ──────────────────────────
*.egg-info/
*.egg
dist/
build/*.egg-info

# ── IDE / editor ──────────────────────────────
.vscode/
.idea/
*.suo
*.user

# ── Kiro AI workspace files ───────────────────
.kiro/

# ── repomix output ────────────────────────────
repomix-output*.xml

# ── Testing / coverage ────────────────────────
.pytest_cache/
.coverage
htmlcov/
*.coverage

# ── OS files ──────────────────────────────────
Thumbs.db
desktop.ini
.DS_Store

# ── Logs & temp ───────────────────────────────
*.log
load_timing.txt
*.tmp
*.bak

# ── ML model weights (גדולים מדי לגיט) ────────
models/MuQ/model.safetensors
models/MuQ/config.json
SongFormer/src/SongFormer/ckpts/*.safetensors
SongFormer/src/SongFormer/ckpts/*.pt
SongFormer/src/SongFormer/ckpts/MusicFM/*.pt
SongFormer/src/SongFormer/ckpts/MusicFM/*.json

# ── SongFormer third-party (ספריות חיצוניות) ──
SongFormer/src/third_party/

# ── Node / JS (אם יהיה בעתיד) ────────────────
node_modules/

# ── קבצי פיתוח מקומיים ────────────────────────
check_deps.py
check_dll.py
setup_models.py
test_torch.py
הפעל.bat
tests/

# ── build — קבצים פנימיים/ישנים ───────────────
build/build.ps1
build/check_sizes.py
build/icon_256_original.png

# ── SongFormer — קוד שלא נחוץ לריצה ───────────
SongFormer/app.py
SongFormer/figs/
SongFormer/src/data_pipeline/
SongFormer/src/SongFormer/train/
SongFormer/src/SongFormer/evaluation/
SongFormer/src/SongFormer/utils/
SongFormer/src/SongFormer/eval.sh
SongFormer/src/SongFormer/train.sh
SongFormer/src/SongFormer/infer.sh

# ── models dir (נכלל בsetup/portable, לא בגיט) ─
models/
